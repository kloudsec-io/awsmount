# Real Linux FUSE end-to-end test image (used by tests/e2e/linux_fuse.sh).
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends fuse3 libfuse2 procps curl \
    && rm -rf /var/lib/apt/lists/*
COPY . /src
RUN pip install --no-cache-dir "/src[fuse,dev]"
WORKDIR /src
ENTRYPOINT ["bash", "/src/tests/e2e/linux_fuse.sh"]
